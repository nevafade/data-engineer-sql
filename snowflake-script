-- Step 1: Create a Stage (points to S3 bucket)
CREATE OR REPLACE STAGE my_stage
  URL = 's3://my-bucket/data/'
  STORAGE_INTEGRATION = my_storage_integration;

-- Step 2: Create a File Format for loading CSVs
CREATE OR REPLACE FILE FORMAT my_csv_format
  TYPE = 'CSV'
  FIELD_DELIMITER = ','
  SKIP_HEADER = 1
  FIELD_OPTIONALLY_ENCLOSED_BY = '"'
  NULL_IF = ('NULL', 'N/A');

-- Step 3: Create the Target Table
CREATE OR REPLACE TABLE my_table (
  id INT,
  name STRING,
  created_at TIMESTAMP
);

-- Step 4: Load data into the Table
COPY INTO my_table
FROM @my_stage
FILE_FORMAT = (FORMAT_NAME = 'my_csv_format');

-- Step 5: Create a File Format for unloading (optional, for clean exports)
CREATE OR REPLACE FILE FORMAT my_unload_format
  TYPE = 'CSV'
  FIELD_DELIMITER = ','
  HEADER = TRUE
  NULL_IF = ('NULL');

-- Step 6: Create a Stage for unloaded files
CREATE OR REPLACE STAGE my_unload_stage
  URL = 's3://my-bucket/unloads/'
  STORAGE_INTEGRATION = my_storage_integration;

-- Step 7: Unload data from Table to S3
COPY INTO @my_unload_stage/my_data_export_
FROM (
  SELECT id, name, created_at
  FROM my_table
)
FILE_FORMAT = (FORMAT_NAME = 'my_unload_format')
OVERWRITE = TRUE
SINGLE = TRUE;

-- Step 8: Create a Scheduled Task to automate the unload daily
CREATE OR REPLACE TASK export_task_daily
  WAREHOUSE = my_wh
  SCHEDULE = 'USING CRON 0 3 * * * UTC'  -- Every day at 3 AM UTC
AS
COPY INTO @my_unload_stage/my_data_export_
FROM (
  SELECT id, name, created_at
  FROM my_table
)
FILE_FORMAT = (FORMAT_NAME = 'my_unload_format')
OVERWRITE = TRUE
SINGLE = TRUE;

-- Step 9: Start the Task
ALTER TASK export_task_daily RESUME;

-- Step 10: Monitor Tasks
SHOW TASKS;

-- (Optional) Check data loaded into table
SELECT * FROM my_table;
